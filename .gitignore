# Python cache/runtime
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tmp/
pytest-cache-files-*/

# 仓库根的历史 pytest 临时目录（basetemp / 试验脚本产物）。
# 这些目录由历史会话在仓库根创建，其中若干被沙箱策略锁定（无法在本会话删除，
# Windows 报 Access denied），因此这里统一忽略，避免它们反复出现在 git status。
# 清理方式见 redesign-audit/19a-backend-notes.md。
/tmp_pg/
/tmp_pytest_*/
/tests/_run_tmp/
/docs/pytest_tmp/

# Virtual environments and local package caches
.venv/
venv/
env/
ENV/
pip-wheel-metadata/

# Local environment, secrets, and credentials
.env
.env.*
!.env.example
*.info
*.pem
*.key
*.crt
*.p12
*.pfx
*.token
*.secret
*.credential
*.credentials
*token*.local
*secret*.local
*credential*.local
secrets/
credentials/
.lab-agent/

# Per-deploy gateway config profiles (port, db path, admin token, etc.).
# Keep config.example.toml tracked so users have a starting point.
config.toml
config.*.toml
!config.example.toml

# Local databases and runtime state
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
buddy2api.db
codebuddy_gateway.db

# 全局通用配置容器（JSON 文件，不进 DB，提交示例 gateway_settings.example.json）
gateway_settings.json
model_limits.json

# data/ 是运行时目录（DB、凭据、快照），整目录不进版本控制。
# 只放行 data/backup/README.md —— 它是快照目录的规范/恢复指南，属于文档。
# 注意：不能只靠 *.db / *.key 这类扩展名规则，因为实际文件名有
# `credentials.key.latest`（.latest 结尾）和
# `codebuddy_gateway.db.bak_before_xxx_20260910_112448`（时间戳结尾），
# 两者都不匹配扩展名通配，会漏网。
data/*
!data/backup/
data/backup/*
!data/backup/README.md
logs/
*.log
.dsh_server.*.log

# Local builds, packages, and exported artifacts
dist/
build/
release/
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# Local-only research/notes/backups
CHANGELOG.md
PRODUCT_IMPROVEMENT_DESIGN.md
codebuddy2openai_协议逆向完整文档.md
_mimo-backup-*/
*.har
*.pcap
*.pcapng

# Editor, OS, and temporary files
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.temp
.DS_Store
Thumbs.db
desktop.ini

# 运行时调试目录
.workbuddy/
.debug/